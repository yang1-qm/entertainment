        const selectedIdx = userAnswers[currentIndex]; // null \uc0\u25110 \u32773  0/1/2\
\
        let html = `<p>$\{q.text\}</p>`;\
        q.options.forEach((opt, idx) => \{\
          const selectedClass = (selectedIdx === idx) ? 'selected' : '';\
          html += `<div class="option $\{selectedClass\}" data-opt-index="$\{idx\}">$\{opt.text\}</div>`;\
        \});\
\
        questionContainer.innerHTML = html;\
\
        // \uc0\u32465 \u23450 \u36873 \u39033 \u28857 \u20987 \
        document.querySelectorAll('.option').forEach(optEl => \{\
          optEl.addEventListener('click', (e) => \{\
            const idx = parseInt(optEl.dataset.optIndex, 10);\
            // \uc0\u31227 \u38500 \u21516 \u32452 \u20854 \u20182 \u36873 \u39033 \u30340  selected\
            document.querySelectorAll('.option').forEach(el => el.classList.remove('selected'));\
            optEl.classList.add('selected');\
            userAnswers[currentIndex] = idx;\
            // \uc0\u38544 \u34255 \u38169 \u35823 \u25552 \u31034 \
            errorMsg.classList.add('hidden');\
          \});\
        \});\
\
        // \uc0\u26174 \u31034 /\u38544 \u34255 \u19978 \u19968 \u39064 \u25353 \u38062  (\u31532 \u19968 \u39064 \u38544 \u34255 )\
        if (currentIndex === 0) \{\
          prevBtn.classList.add('hidden');\
        \} else \{\
          prevBtn.classList.remove('hidden');\
        \}\
\
        // \uc0\u26681 \u25454 \u26159 \u21542 \u24050 \u32463 \u36873 \u36807 \u31572 \u26696 \u65292 \u26816 \u26597 \u26174 \u31034 \
        // (\uc0\u26080 \u38656 \u39069 \u22806 \u25805 \u20316 )\
      \}\
\
      // \uc0\u26356 \u26032 \u36827 \u24230 \u26465 \
      function updateProgress() \{\
        const total = QUESTIONS.length;\
        const answeredCount = userAnswers.filter(a => a !== null).length; // \uc0\u24050 \u31572 \u39064 \u25968 \u65292 \u20294 \u36827 \u24230 \u26465 \u25353 \u29031 \u24403 \u21069 \u39064 \u21495 \u26174 \u31034 \u26356 \u30452 \u35266 \u65292 \u20294 \u25105 \u20204 \u21487 \u20197 \u29992 \u24050 \u31572 \u25968 \u65292 \u19981 \u36807 \u26681 \u25454 \u39029 \u30721 \u26174 \u31034 \u24403 \u21069 \u39064 \
        const current = currentIndex + 1;\
        progressLabel.textContent = `\uc0\u31532  $\{current\} / $\{total\} \u39064 `;\
        const percent = Math.round(((current - 1) / total) * 100); // \uc0\u24050 \u23436 \u25104 \u30340 \u39064 \u27604 \u20363 \u65292 \u26356 \u31526 \u21512 \u30452 \u35273 \u65292 \u25110 \u20351 \u29992  (current/total)? \u25105 \u20204 \u20351 \u29992 \u24050 \u31572 \u25968 \u65311 \
        // \uc0\u20294 \u24863 \u35273 \u29992  currentIndex \u27604 \u20363 \u26356 \u33258 \u28982 : (currentIndex / total)*100 \u36825 \u26679 \u31532 \u19968 \u39064 0%\u65292 \u31532 \u21313 \u39064 90%\
        // \uc0\u25110 \u32773 \u25353 \u29031  (currentIndex) / total *100 \u24403 \u23436 \u25104 \u31532 10\u39064 \u25552 \u20132 \u21518 \u21464 \u25104 100%? \u25105 \u20204 \u22312 \u25552 \u20132 \u21518 \u26174 \u31034 \u32467 \u26524 \u20063 \u34892 \
        // \uc0\u20351 \u29992  (currentIndex / total)*100 \u20294 \u26368 \u21518 \u19968 \u39064 \u36827 \u24230 90%\u65292 \u19981 \u22826 \u29702 \u24819 \u65292 \u21487 \u20197 \u25913 \u29992 \u24050 \u23436 \u25104 \u39064 \u25968 \u65311 \u20294 \u29992 \u25143 \u21487 \u20197 \u38543 \u26102 \u25913 \u19978 \u19968 \u39064 \u12290 \
        // \uc0\u23601 \u29992  (currentIndex / total)*100 \u21543 \u65292 \u20294 \u26368 \u21518 \u19968 \u39064 \u26159 90%\u65292 \u25552 \u20132 \u21518 \u21040 100%\u22312 \u32467 \u26524 \u39029 \u25105 \u20204 \u19981 \u20877 \u26174 \u31034 \u36827 \u24230 \u12290 \
        // \uc0\u26356 \u22909 : \u20351 \u29992  (currentIndex) / total *100 \u25552 \u20132 \u21518 \u38544 \u34255 \u12290 \
        const progressValue = (currentIndex) / total * 100;\
        progressFill.style.width = `$\{progressValue\}%`;\
        progressPercent.textContent = `$\{Math.round(progressValue)\}%`;\
      \}\
\
      // \uc0\u35745 \u31639 \u24471 \u20998 \
      function calculateScores() \{\
        resetScores();\
        for (let i = 0; i < QUESTIONS.length; i++) \{\
          const optIdx = userAnswers[i];\
          if (optIdx === null) continue; // \uc0\u29702 \u35770 \u19978 \u20840 \u37096 \u31572 \u23436 \u25165 \u20250 \u35843 \u29992 \
          const opt = QUESTIONS[i].options[optIdx];\
          if (opt && opt.weights) \{\
            for (const [beast, weight] of Object.entries(opt.weights)) \{\
              if (beast in scores) \{\
                scores[beast] = (scores[beast] || 0) + weight;\
              \}\
              // \uc0\u24573 \u30053 \u19981 \u23384 \u22312 \u30340 \u31070 \u20861 \u22914 \u28151 \u27788 \
            \}\
          \}\
        \}\
      \}\
\
      // \uc0\u33719 \u21462 \u26368 \u39640 \u20998 \u31070 \u20861  (\u22914 \u26524 \u24179 \u23616 \u65292 \u21462 \u31532 \u19968 \u20010 \u36935 \u21040 \u30340 \u26368 \u39640 \u20998 \u65292 \u25110 \u32773 \u25353 \u23383 \u27597 \u39034 \u24207 \u65311 \u36825 \u37324 \u25353 \u20998 \u25968 \u38477 \u24207 \u65292 \u21516 \u20998 \u25353 \u21407 \u22987 BEASTS\u39034 \u24207 \u65311 \u25105 \u20204 \u32473 \u20010 \u22266 \u23450 \u20248 \u20808 \u32423 )\
      function getTopBeast() \{\
        let maxScore = -Infinity;\
        let topBeast = '\uc0\u20964 \u20976 '; // \u40664 \u35748 \
        // \uc0\u20026 \u20102 \u35753 \u24179 \u23616 \u26102 \u31245 \u24494 \u38543 \u26426 \u65292 \u20294 \u22266 \u23450 \u25353 \u23545 \u35937 \u38190 \u39034 \u24207 \u65311 \u20294 \u26368 \u22909 \u24179 \u23616 \u26102 \u25353 \u39044 \u35774 \u39034 \u24207 , \u25105 \u20204 \u25353 BEASTS\u23450 \u20041 \u39034 \u24207 \
        for (const key of Object.keys(BEASTS)) \{\
          const score = scores[key] || 0;\
          if (score > maxScore) \{\
            maxScore = score;\
            topBeast = key;\
          \}\
        \}\
        return topBeast;\
      \}\
\
      // \uc0\u25552 \u20132 \u24403 \u21069 \u39064 \u30446  -> \u22914 \u26524 \u26159 \u26368 \u21518 \u19968 \u39064 \u21017 \u35745 \u31639 \u32467 \u26524 \u65292 \u21542 \u21017 \u36827 \u20837 \u19979 \u19968 \u39064 \
      function handleSubmit() \{\
        // \uc0\u26816 \u26597 \u24403 \u21069 \u39064 \u30446 \u26159 \u21542 \u36873 \u20013 \u36873 \u39033 \
        if (userAnswers[currentIndex] === null) \{\
          errorMsg.classList.remove('hidden');\
          return;\
        \}\
        errorMsg.classList.add('hidden');\
\
        if (currentIndex === QUESTIONS.length - 1) \{\
          // \uc0\u26368 \u21518 \u19968 \u39064 \u65292 \u26816 \u26597 \u26159 \u21542 \u20840 \u37096 \u24050 \u31572 \
          const allAnswered = userAnswers.every(a => a !== null);\
          if (!allAnswered) \{\
            // \uc0\u25214 \u21040 \u31532 \u19968 \u20010 \u26410 \u31572 \u39064 \u36339 \u36716 \
            const firstUnanswered = userAnswers.findIndex(a => a === null);\
            if (firstUnanswered !== -1) \{\
              currentIndex = firstUnanswered;\
              renderQuestion();\
              updateProgress();\
              errorMsg.textContent = '\uc0\u36824 \u26377 \u39064 \u30446 \u26410 \u20316 \u31572 ';\
              errorMsg.classList.remove('hidden');\
              return;\
            \}\
          \}\
          // \uc0\u35745 \u31639 \u24182 \u26174 \u31034 \u32467 \u26524 \
          calculateScores();\
          const topBeast = getTopBeast();\
          renderResult(topBeast);\
        \} else \{\
          // \uc0\u31227 \u21160 \u21040 \u19979 \u19968 \u39064 \
          currentIndex++;\
          renderQuestion();\
          updateProgress();\
          errorMsg.classList.add('hidden');\
