      \}\
\
      // \uc0\u19978 \u19968 \u39064 \
      function handlePrev() \{\
        if (currentIndex > 0) \{\
          currentIndex--;\
          renderQuestion();\
          updateProgress();\
          errorMsg.classList.add('hidden');\
        \}\
      \}\
\
      // \uc0\u28210 \u26579 \u32467 \u26524 \u39029 \
      function renderResult(beastKey) \{\
        const beast = BEASTS[beastKey];\
        if (!beast) return;\
\
        // \uc0\u26500 \u24314 \u32467 \u26524 html\
        const html = `\
          <div class="beast-card">\
            <div class="beast-name">$\{beast.name\}</div>\
            <div class="beast-title">\uc0\u20320 \u26159 \u65306 $\{beast.identity\}</div>\
            <div class="detail-item">\
              <div class="label">\uc0\u20986 \u29983 \u22320 </div>\
              <div class="value">$\{beast.birthplace\}</div>\
            </div>\
            <div class="detail-item">\
              <div class="label">\uc0\u26085 \u24120 </div>\
              <div class="value">$\{beast.daily\}</div>\
            </div>\
          </div>\
          <div class="entertainment-note">\
            <strong>\uc0\u20165 \u20379 \u23089 \u20048 \u65292 \u19981 \u20570 \u20219 \u20309 \u19987 \u19994 \u35786 \u26029 </strong><br>\
            \uc0\u25152 \u26377 \u32467 \u35770 \u20165 \u29992 \u20110 \u23089 \u20048 \u65292 \u19981 \u25910 \u38598 \u20219 \u20309 \u20010 \u20154 \u20449 \u24687 \u12290 \
          </div>\
          <button id="restartBtn" class="secondary" style="margin-top: 16px;">\uc0\u20877 \u27979 \u19968 \u27425 </button>\
        `;\
\
        resultScreen.innerHTML = html;\
\
        // \uc0\u38544 \u34255 quiz, \u26174 \u31034 result\
        quizScreen.classList.add('hidden');\
        startScreen.classList.add('hidden');\
        resultScreen.classList.remove('hidden');\
\
        // \uc0\u32465 \u23450 \u37325 \u26032 \u24320 \u22987 \u25353 \u38062 \
        document.getElementById('restartBtn').addEventListener('click', () => \{\
          restartTest();\
        \});\
\
        // \uc0\u21487 \u36873 \u65292 \u25226 \u36827 \u24230 \u26465 \u32622 \u20026 100%\u20294 \u22312 \u32467 \u26524 \u39029 \u19981 \u21487 \u35265 \
      \}\
\
      // \uc0\u20107 \u20214 \u32465 \u23450 \
      startBtn.addEventListener('click', () => \{\
        restartTest();\
      \});\
\
      submitBtn.addEventListener('click', handleSubmit);\
\
      prevBtn.addEventListener('click', handlePrev);\
\
      // \uc0\u21021 \u22987 \u21270 \u26174 \u31034 \u24320 \u22987 \u23631 \u24149 \
      showStart();\
\
      // \uc0\u37325 \u32622 \u20998 \u25968 \
      resetScores();\
\
    \})();\
  </script>\
